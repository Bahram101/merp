{
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "SERVER_URL": "https://api-test.aura-it.kz:9443",
        "APP_VARIANT": "development"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "SERVER_URL": "https://api-test.aura-it.kz:9443"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "preview-simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true
      }
    },
    "staging": {
      "channel": "staging",
      "autoIncrement": true,
      "env": {
        "SERVER_URL": "https://api-test.aura-it.kz:9443",
        "APP_VARIANT": "development"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "SERVER_URL": "https://api-prod.aura-it.kz:9443"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      }
    }
  },
  "submit": {
    "staging": {},
    "production": {}
  },
  "cli": {
    "appVersionSource": "remote"
  }
}
